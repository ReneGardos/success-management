# Public URL of Success Management (used in links in mails and quotes)
NEXT_PUBLIC_APP_URL=https://success-management.vercel.app

# Supabase (project tdsjrglubylnihdrvkpf)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
# Fallback sending domain for organizations without their own verified domain
RESEND_EMAIL_DOMAIN=successcleaningaps.dk
# Inbound replies: <alias>+<thread>@RESEND_INBOUND_DOMAIN → POST /api/email/inbound
RESEND_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=

# Salt for the daily-rotating, cookieless visitor hash
ANALYTICS_SALT=
